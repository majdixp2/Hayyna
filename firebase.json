{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/o/**", "destination": "/index.html" },
      { "source": "/s/**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": [
    {
      "database": "ai-studio-android-307cc811-cd30-4d36-b6c1-76e9fb2ac335",
      "rules": "firestore.rules"
    }
  ]
}
