rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // نفس القائمة الموجودة في AdminConfig.kt داخل التطبيق
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['majdixp2@gmail.com'];
    }

    // ===== فريق الإدارة: موظفين بصلاحيات محددة (المالك فوق يقدر كل شي) =====
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function staffRef() { return /databases/$(database)/documents/staff/$(myEmail()); }
    function isStaff() {
      return isAuthenticated() && request.auth.token.get('email_verified', false) == true && myEmail() != ''
        && exists(staffRef()) && get(staffRef()).data.get('active', false) == true;
    }
    // review: مراجعة العروض والبلاغات • verify: التوثيق • messages: الرسائل • merchants: التجار والإحالات • credits: الأكواد والأرصدة
    function can(perm) {
      return isAdmin() || (isStaff() && perm in get(staffRef()).data.get('perms', []));
    }
    function canStores() { return can('review') || can('verify') || can('merchants'); }

    function optInt(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0);
    }

    function validMinute(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= -1 && data[key] <= 1439);
    }

    // العروض مع المنيو: خصم / باقة / 1+1 / إعلان
    function validDeal(d) {
      return d is map
        && d.keys().hasOnly(['type', 'scope', 'kind', 'section', 'itemIds', 'itemId', 'getPct', 'orderable'])
        && d.type in ['discount', 'bundle', 'bogo', 'promo']
        && (!('scope' in d) || d.scope in ['all', 'kind', 'section', 'items'])
        && (!('kind' in d) || (d.kind is string && d.kind.size() <= 20))
        && (!('section' in d) || (d.section is string && d.section.size() <= 40))
        && (!('itemIds' in d) || (d.itemIds is list && d.itemIds.size() <= 50))
        && (!('itemId' in d) || (d.itemId is string && d.itemId.size() <= 120))
        && (!('getPct' in d) || d.getPct in [50, 100])
        && (!('orderable' in d) || d.orderable is bool)
        && (d.type != 'bogo' || ('itemId' in d && d.itemId.size() > 0));
    }

    function isValidOffer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.merchantId is string
        && data.restaurantName is string && data.restaurantName.size() > 0 && data.restaurantName.size() <= 100
        && data.offerTitle is string && data.offerTitle.size() > 0 && data.offerTitle.size() <= 150
        && data.description is string && data.description.size() <= 2000
        && data.cuisineType is string && data.cuisineType.size() <= 60
        && data.price is number && data.price >= 0
        && (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0))
        && data.currency is string && data.currency.size() <= 10
        && (!('discountBadge' in data) || (data.discountBadge is string && data.discountBadge.size() <= 60))
        && data.mediaType in ['IMAGE', 'VIDEO']
        && data.mediaUri is string && data.mediaUri.size() > 0 && data.mediaUri.size() <= 2000
        && (!('isPromotionalVideo' in data) || data.isPromotionalVideo is bool)
        && data.district is string && data.district.size() <= 100
        && data.region is string && data.region.size() <= 100
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.phone is string && data.phone.size() <= 30
        && (!('workingHours' in data) || (data.workingHours is string && data.workingHours.size() <= 120))
        && validMinute(data, 'openMinute') && validMinute(data, 'closeMinute')
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp)
        && (!('startsAt' in data) || data.startsAt == null || data.startsAt is timestamp)
        && (!('discountPercent' in data) || (data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 100))
        && (!('dailyPercents' in data) || (data.dailyPercents is list && data.dailyPercents.size() <= 14))
        && (!('itemsScope' in data) || (data.itemsScope is string && data.itemsScope.size() <= 60))
        && (!('grandOpening' in data) || data.grandOpening is bool)
        && (!('postType' in data) || data.postType in ['offer', 'new'])
        && (!('exclusive' in data) || data.exclusive is bool)
        && (!('draft' in data) || data.draft is bool)
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 12))
        && (!('delivery' in data) || data.delivery is bool)
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('isApproved' in data) || data.isApproved is bool)
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && optInt(data, 'viewsCount') && optInt(data, 'directionsCount') && optInt(data, 'whatsappCount')
        && optInt(data, 'reportsCount')
        && (!('mediaUris' in data) || (data.mediaUris is list && data.mediaUris.size() <= 3))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 2000))
        && (!('branches' in data) || (data.branches is list && data.branches.size() <= 50))
        && data.createdAt is timestamp;
    }

    // زيادة عدّاد واحد فقط بمقدار 1
    function incrementsOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    // الزوار (حتى بدون تسجيل) يقدرون يزيدون المشاهدات / الاتجاه / واتساب / البلاغات فقط
    function isCounterIncrement() {
      return incrementsOnly('viewsCount')
        || incrementsOnly('directionsCount')
        || incrementsOnly('whatsappCount')
        || incrementsOnly('reportsCount');
    }

    // ---------- حالة التاجر (يكتبها الأدمن فقط) ----------
    function statusPath(uid) {
      return /databases/$(database)/documents/merchantStatus/$(uid);
    }

    function isSuspended(uid) {
      return exists(statusPath(uid)) && get(statusPath(uid)).data.get('suspended', false) == true;
    }

    // الموثوق ينشر مباشرة، غيره عروضه تروح للمراجعة
    function isTrusted(uid) {
      return isAdmin()
        || (exists(statusPath(uid))
            && get(statusPath(uid)).data.get('trusted', false) == true
            && get(statusPath(uid)).data.get('suspended', false) != true);
    }

    // غير الموثوق لازم ينشر/يعدّل والعرض "بانتظار المراجعة"
    function approvalAllowed(uid) {
      return isTrusted(uid) || request.resource.data.get('isApproved', false) == false;
    }

    function keepsProtectedFields() {
      return request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.get('isFeatured', false) == resource.data.get('isFeatured', false)
        && request.resource.data.get('viewsCount', 0) == resource.data.get('viewsCount', 0)
        && request.resource.data.get('directionsCount', 0) == resource.data.get('directionsCount', 0)
        && request.resource.data.get('whatsappCount', 0) == resource.data.get('whatsappCount', 0)
        && request.resource.data.get('reportsCount', 0) == resource.data.get('reportsCount', 0);
    }

    // إعدادات عامة (رقم الدعم...): الكل يقرأ، الأدمن فقط يكتب
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // تواصل معنا: أي أحد يرسل، وصاحب الرسالة يشوف رسائله وردودها، والأدمن يدير الكل
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'userName', 'role', 'type', 'message', 'screenshotUrl', 'contact', 'appVersion', 'device', 'status', 'reply', 'replySeen', 'createdAt'])
        && (request.resource.data.uid == null || (isAuthenticated() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.screenshotUrl is string && request.resource.data.screenshotUrl.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.createdAt == request.time;
      allow read: if can('messages') || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // صاحب الرسالة يعلّم الرد "مقروء" فقط
      allow update: if can('messages')
        || (isAuthenticated() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replySeen']));
      allow delete: if can('messages');
    }

    // الاهتمام بمحلات Google غير المسجّلة: عدّادات فقط (نخزّن معرّف المكان، بدون بيانات Google)
    function poiCounterOk(key) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is int
            && request.resource.data[key] >= resource.data.get(key, 0)
            && request.resource.data[key] <= resource.data.get(key, 0) + 1);
    }
    match /poiInterest/{placeId} {
      allow read: if can('merchants');
      allow create: if request.resource.data.keys().hasOnly(['taps', 'invites', 'claims', 'lastAt'])
        && request.resource.data.lastAt == request.time
        && (!('taps' in request.resource.data) || request.resource.data.taps == 1)
        && (!('invites' in request.resource.data) || request.resource.data.invites == 1)
        && (!('claims' in request.resource.data) || request.resource.data.claims == 1);
      allow update: if request.resource.data.keys().hasOnly(['taps', 'invites', 'claims', 'lastAt'])
        && request.resource.data.lastAt == request.time
        && poiCounterOk('taps') && poiCounterOk('invites') && poiCounterOk('claims');
      allow delete: if can('merchants');
    }

    // نوع الحساب (عميل / تاجر): صاحبه فقط
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || can('merchants') || can('verify') || can('credits'));
      allow delete: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.role in ['customer', 'merchant']
        && (!('favorites' in request.resource.data) || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 500));
    }

    function validStoreWrite(uid) {
      return !isSuspended(uid)
        && (request.resource.data.approved == false || isTrusted(uid))
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.about is string && request.resource.data.about.size() <= 500
        && request.resource.data.menuImages is list && request.resource.data.menuImages.size() <= 10
        && request.resource.data.branches is list && request.resource.data.branches.size() <= 50
        // الرقم الضريبي (اختياري): 15 رقم يبدأ وينتهي بـ 3
        && (!('vatNumber' in request.resource.data) || request.resource.data.vatNumber == ''
            || (request.resource.data.vatNumber is string && request.resource.data.vatNumber.matches('^3[0-9]{13}3$')));
    }

    // طلبات توثيق المتاجر: التاجر يرسل طلبه ويشوفه، والأدمن يقرّر
    match /verificationRequests/{uid} {
      allow read: if can('verify') || (isAuthenticated() && request.auth.uid == uid);
      allow create, update: if can('verify')
        || (isAuthenticated() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'storeName', 'docType', 'docNumber', 'photoUrl', 'locationChecked', 'locationOk', 'distanceMeters', 'status', 'rejectReason', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.rejectReason == ''
          && request.resource.data.docNumber is string && request.resource.data.docNumber.size() <= 40
          && request.resource.data.storeName is string && request.resource.data.storeName.size() <= 100
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2000
          && request.resource.data.createdAt == request.time);
      allow delete: if can('verify');
    }

    // صفحة المتجر العامة: الكل يشوف المعتمدة، وصاحبها يعدّل (غير الموثوق تروح للمراجعة)
    match /stores/{uid} {
      allow read: if resource.data.approved == true
        || (isAuthenticated() && request.auth.uid == uid)
        || canStores();
      allow create: if isAdmin()
        || (isAuthenticated() && request.auth.uid == uid && validStoreWrite(uid)
          && request.resource.data.get('verified', false) == false);
      // التاجر ما يقدر يوثّق نفسه — علامة ✓ يحطها الأدمن فقط
      allow update: if canStores()
        || (isAuthenticated() && request.auth.uid == uid && validStoreWrite(uid)
          && request.resource.data.get('verified', false) == resource.data.get('verified', false));
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // ===== رصيد العروض (يُشحن بأكواد من متجر سلة، ويُصرف على خدمات حيّنا) =====
    function creditsCfg() {
      return get(/databases/$(database)/documents/config/app).data.get('credits', {});
    }
    function walletPath(uid) { return /databases/$(database)/documents/wallets/$(uid); }
    function codePath(code) { return /databases/$(database)/documents/creditCodes/$(code); }
    function boostPath(id) { return /databases/$(database)/documents/boosts/$(id); }
    function passPath(id) { return /databases/$(database)/documents/itemPasses/$(id); }

    // شحن: الكود ينتقل من "غير مستخدم" لصاحب المحفظة في نفس العملية، والرصيد يزيد بقيمته بالضبط
    function walletRedeemOk(uid) {
      let op = request.resource.data.lastOp;
      let before = get(codePath(op.ref)).data;
      let after = getAfter(codePath(op.ref)).data;
      let old = resource == null ? 0 : resource.data.balance;
      return op.kind == 'redeem'
        && before.get('redeemedBy', null) == null
        && after.redeemedBy == uid
        && request.resource.data.balance == old + before.points;
    }
    // صرف: يُنشأ سجل خدمة (boost) جديد في نفس العملية، والرصيد ينقص بتكلفته بالضبط
    function walletSpendOk(uid) {
      let op = request.resource.data.lastOp;
      return op.kind == 'spend'
        && !exists(boostPath(op.ref))
        && existsAfter(boostPath(op.ref))
        && getAfter(boostPath(op.ref)).data.merchantId == uid
        && request.resource.data.balance == resource.data.balance - getAfter(boostPath(op.ref)).data.cost
        && request.resource.data.balance >= 0;
    }
    // صرف على ظهور المنتجات (itemPasses): نفس فكرة الخدمات
    function walletCatalogOk(uid) {
      let op = request.resource.data.lastOp;
      return op.kind == 'catalog'
        && !exists(passPath(op.ref))
        && existsAfter(passPath(op.ref))
        && getAfter(passPath(op.ref)).data.merchantId == uid
        && request.resource.data.balance == resource.data.balance - getAfter(passPath(op.ref)).data.cost
        && request.resource.data.balance >= 0;
    }
    function walletShapeOk() {
      return request.resource.data.keys().hasOnly(['balance', 'lastOp', 'updatedAt'])
        && request.resource.data.balance is int
        && request.resource.data.lastOp.keys().hasOnly(['kind', 'ref'])
        && request.resource.data.lastOp.ref is string && request.resource.data.lastOp.ref.size() <= 64
        && request.resource.data.updatedAt == request.time;
    }

    match /wallets/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || can('credits'));
      allow create: if can('credits')
        || (isAuthenticated() && request.auth.uid == uid && walletShapeOk()
          && ((request.resource.data.lastOp.kind == 'welcome' && request.resource.data.balance == creditsCfg().get('welcome', 0))
            || walletRedeemOk(uid)));
      allow update: if can('credits')
        || (isAuthenticated() && request.auth.uid == uid && walletShapeOk()
          && (walletRedeemOk(uid) || walletSpendOk(uid) || walletCatalogOk(uid)));
      allow delete: if can('credits');

      // سجل الحركات (للعرض فقط؛ الرصيد نفسه محمي فوق)
      match /tx/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || can('credits'));
        allow create: if can('credits')
          || (isAuthenticated() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['kind', 'points', 'note', 'ref', 'at'])
            && request.resource.data.kind in ['redeem', 'spend', 'welcome']
            && request.resource.data.points is int
            && request.resource.data.note is string && request.resource.data.note.size() <= 120
            && request.resource.data.at == request.time);
        allow update, delete: if can('credits');
      }
    }

    // أكواد الشحن: الأدمن ينشئها، وأي مسجّل يقرأ كود يعرفه ويستخدمه مرة وحدة
    match /creditCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if can('credits');
      allow create, delete: if can('credits');
      allow update: if can('credits')
        || (isAuthenticated()
          && resource.data.get('redeemedBy', null) == null
          && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt'])
          && request.resource.data.redeemedBy == request.auth.uid
          && request.resource.data.redeemedAt == request.time
          && getAfter(walletPath(request.auth.uid)).data.lastOp.kind == 'redeem'
          && getAfter(walletPath(request.auth.uid)).data.lastOp.ref == code);
    }

    // مكافأة الحصري: خصم (1-100%) على «النشر» بس، للعروض الحصرية، لما يشغّلها الأدمن
    function exclCfg() {
      return get(/databases/$(database)/documents/config/app).data.get('exclusive', {});
    }
    function exclDiscountOk(it, d, base) {
      let r = exclCfg().get('reward', {});
      let pct = r.get('percent', 0);
      return it.effect == 'publish'
        && exclCfg().get('enabled', true) == true
        && r.get('enabled', false) == true
        && pct is int && pct >= 1 && pct <= 100
        && getAfter(/databases/$(database)/documents/offers/$(d.offerId)).data.get('exclusive', false) == true
        && d.get('disc', 0) == pct
        // السعر بعد الخصم مقرّب لفوق: cost = ceil(base × (100 - pct) / 100)
        && d.cost * 100 >= base * (100 - pct)
        && (d.cost - 1) * 100 < base * (100 - pct);
    }
    function exclRewardOn() {
      return exclCfg().get('reward', {}).get('enabled', false) == true;
    }
    // خدمات مدفوعة (نشر / تمييز / إعلان بارز): السعر من إعدادات الأدمن، والخصم من المحفظة بنفس العملية
    function boostOk(d) {
      let it = creditsCfg().get('items', {}).get(d.item, null);
      let base = it == null ? 0 : (it.unit == 'day' ? it.price * d.days : it.price);
      return it != null && it.get('active', false) == true
        && d.effect == it.effect
        && d.days is int && d.days >= 1 && d.days <= 90
        && (it.unit == 'day' || d.days == it.days)
        && d.cost is int && d.cost >= 0
        && ((d.cost == base && d.cost > 0 && !('disc' in d)) || exclDiscountOk(it, d, base))
        && d.createdAt == request.time
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.startsAt >= request.time - duration.value(1, 'h')
        && d.startsAt <= request.time + duration.value(61, 'd')
        && d.endsAt > d.startsAt
        && d.endsAt <= d.startsAt + duration.value(d.days, 'd') + duration.value(1, 'h')
        && getAfter(/databases/$(database)/documents/offers/$(d.offerId)).data.merchantId == request.auth.uid
        // مجاني (حصري 100%) ما يلمس المحفظة، غيره لازم الخصم بنفس العملية
        && (d.cost == 0 || getAfter(walletPath(request.auth.uid)).data.lastOp.ref == d.id);
    }
    match /boosts/{boostId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.keys().hasOnly(['id', 'merchantId', 'offerId', 'item', 'effect', 'days', 'cost', 'disc', 'createdAt', 'startsAt', 'endsAt'])
          && request.resource.data.id == boostId
          && request.resource.data.merchantId == request.auth.uid
          && request.resource.data.offerId is string
          && boostOk(request.resource.data));
      allow update, delete: if isAdmin();
    }

    // ===== المنتجات والخدمات والمنيو (يتحكم فيها الأدمن: config/app.catalog) =====
    function catalogCfg() {
      return get(/databases/$(database)/documents/config/app).data.get('catalog', {});
    }
    function featureOn(k) {
      return catalogCfg().get('features', {}).get(k, true) == true;
    }
    function itemLimit(kind) {
      return catalogCfg().get('limits', {}).get(kind, 10);
    }
    function isVerifiedStore(uid) {
      return exists(statusPath(uid)) && get(statusPath(uid)).data.get('verified', false) == true
        && get(statusPath(uid)).data.get('suspended', false) != true;
    }
    function itemOk(uid, itemId, d) {
      return d.keys().hasOnly(['id', 'merchantId', 'kind', 'slot', 'name', 'desc', 'price', 'imageUrl', 'section', 'available', 'approved', 'adminNote', 'createdAt', 'updatedAt'])
        // ملاحظة الأدمن («↩️ رجّعه للتاجر»): التاجر يمسحها لما يعدّل، أو تبقى والمنتج مخفي
        && (d.get('adminNote', '') == '' || (resource != null && d.adminNote == resource.data.get('adminNote', '') && d.approved == false))
        && catalogCfg().get('enabled', false) == true
        && !isSuspended(uid)
        && d.id == itemId && d.merchantId == uid
        && d.kind in ['menu', 'product', 'service']
        // كل منتج له خانة (slot) رقمها أقل من الحد اللي يحدده الأدمن (0 = مفتوح)
        && d.slot is int && d.slot >= 0 && d.slot < 1000
        && (itemLimit(d.kind) == 0 || d.slot < itemLimit(d.kind))
        && itemId == uid + '_' + d.kind + '_' + string(d.slot)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.desc is string && d.desc.size() <= 300
        && d.price is number && d.price >= 0 && d.price <= 1000000
        && d.imageUrl is string && d.imageUrl.size() <= 2000
        && d.section is string && d.section.size() <= 40
        && d.available is bool && d.approved is bool
        // التاجر الجديد: تنراجع. الموثّق/الموثوق: تنزل مباشرة
        && (d.approved == false || isTrusted(uid) || isVerifiedStore(uid) || catalogCfg().get('review', true) == false)
        && d.updatedAt == request.time;
    }
    match /items/{itemId} {
      allow read: if resource.data.approved == true
        || (isAuthenticated() && resource.data.merchantId == request.auth.uid)
        || can('review');
      allow create: if can('review')
        || (isAuthenticated() && itemOk(request.auth.uid, itemId, request.resource.data)
          && request.resource.data.createdAt == request.time);
      allow update: if can('review')
        || (isAuthenticated() && resource.data.merchantId == request.auth.uid
          && itemOk(request.auth.uid, itemId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if can('review') || (isAuthenticated() && resource.data.merchantId == request.auth.uid);
    }

    // ظهور المنتجات المدفوع: باقة كل المنتجات، أو منتجات محددة من نوع واحد. السعر بالهللة من إعدادات الأدمن
    function passOk(d) {
      let pr = catalogCfg().get('pricing', {});
      let it = pr.get(d.scope == 'all' ? 'all' : d.kind, {});
      let ph = it.get('priceH', 0);
      let n = d.scope == 'all' ? 1 : d.itemIds.size();
      return pr.get('enabled', false) == true && it.get('active', false) == true
        && ph is int && ph > 0
        && (d.scope == 'all' || (d.scope == 'kind' && d.kind in ['menu', 'product', 'service']))
        && d.itemIds is list && d.itemIds.size() <= 200 && (d.scope == 'all' || d.itemIds.size() >= 1)
        && d.days is int && d.days >= 1 && d.days <= 365
        && d.cost is int && d.cost * 100 >= n * d.days * ph && (d.cost - 1) * 100 < n * d.days * ph
        && d.createdAt == request.time
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.startsAt >= request.time - duration.value(1, 'h')
        && d.startsAt <= request.time + duration.value(366, 'd')
        && d.endsAt > d.startsAt
        && d.endsAt <= d.startsAt + duration.value(d.days, 'd') + duration.value(1, 'h')
        && getAfter(walletPath(request.auth.uid)).data.lastOp.ref == d.id;
    }
    match /itemPasses/{passId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.keys().hasOnly(['id', 'merchantId', 'scope', 'kind', 'itemIds', 'days', 'cost', 'createdAt', 'startsAt', 'endsAt'])
          && request.resource.data.id == passId
          && request.resource.data.merchantId == request.auth.uid
          && passOk(request.resource.data));
      allow update, delete: if isAdmin();
    }

    // الطلبات: الزبون المسجّل يحفظ طلبه قبل ما ينرسل للمحل على واتساب (جاهزة للدفع المباشر لاحقاً)
    match /orders/{orderId} {
      allow create: if isAuthenticated()
        && catalogCfg().get('orderEnabled', false) == true
        && request.resource.data.keys().hasOnly(['id', 'code', 'storeId', 'storeName', 'branchId', 'branchName', 'customerUid', 'customerName', 'customerPhone',
            'items', 'subtotal', 'discount', 'deliveryFee', 'total', 'vatRate', 'vatAmount', 'vatNumber', 'mode', 'location', 'note', 'pay', 'car', 'status', 'createdAt', 'updatedAt'])
        && (!('pay' in request.resource.data) || request.resource.data.pay in ['cash', 'card'])
        && (!('car' in request.resource.data) || (request.resource.data.car is string && request.resource.data.car.size() <= 60))
        && request.resource.data.id == orderId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.storeId is string && request.resource.data.storeId.size() > 0
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total >= 0
        && (!('discount' in request.resource.data) || (request.resource.data.discount is number && request.resource.data.discount >= 0))
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.mode in ['pickup', 'delivery', 'curbside']
        && (request.resource.data.mode != 'curbside' || featureOn('curbside'))
        && request.resource.data.status == 'sent'
        && request.resource.data.createdAt == request.time;
      allow read: if can('merchants')
        || (isAuthenticated() && (resource.data.customerUid == request.auth.uid || resource.data.storeId == request.auth.uid));
      // المحل يحدّث الحالة، والزبون يلغي طلبه لو ما استلمه المحل للحين
      allow update: if can('merchants')
        || (isAuthenticated() && resource.data.storeId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'etaAt'])
          && request.resource.data.status in ['received', 'ready', 'delivering', 'done', 'cancelled']
          && (!('etaAt' in request.resource.data) || request.resource.data.etaAt is timestamp))
        || (isAuthenticated() && resource.data.customerUid == request.auth.uid
          && resource.data.status == 'sent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled')
        // 🚗 الزبون يبلّغ إنه وصل (استلام من السيارة)
        || (isAuthenticated() && resource.data.customerUid == request.auth.uid
          && resource.data.mode == 'curbside' && resource.data.status in ['received', 'ready']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrivedAt', 'updatedAt'])
          && request.resource.data.arrivedAt == request.time);
      allow delete: if can('merchants');
    }

    // تقييم الطلب: الزبون صاحب الطلب، بعد ما يخلص، مرة وحدة (معرّف التقييم = معرّف الطلب)
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }
    match /ratings/{orderId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && featureOn('ratings')
        && request.resource.data.keys().hasOnly(['orderId', 'storeId', 'uid', 'name', 'stars', 'text', 'at'])
        && request.resource.data.orderId == orderId
        && request.resource.data.uid == request.auth.uid
        && exists(orderPath(orderId))
        && get(orderPath(orderId)).data.customerUid == request.auth.uid
        && get(orderPath(orderId)).data.status == 'done'
        && request.resource.data.storeId == get(orderPath(orderId)).data.storeId
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if can('merchants');
    }

    // قفل دعوة محل من Google: أول من يدعوه يحجزه كم يوم (عشان ما يتكرر الإزعاج للمحل)
    match /poiInvites/{placeId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['by', 'at', 'until'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.until is timestamp
        && request.resource.data.until > request.time
        && request.resource.data.until <= request.time + duration.value(6, 'd')
        && (resource == null || resource.data.until < request.time || resource.data.by == request.auth.uid);
      allow delete: if isAdmin();
    }

    // الإحالات: المحل يسجّل مين دعاه (مرة وحدة، بدون نقاط)، والنقاط يحطها الأدمن فقط
    match /referrals/{storeUid} {
      allow read: if can('merchants')
        || (isAuthenticated() && (resource.data.referrer == request.auth.uid || storeUid == request.auth.uid));
      allow create: if isAuthenticated() && request.auth.uid == storeUid
        && request.resource.data.keys().hasOnly(['referrer', 'storeUid', 'storeName', 'createdAt', 'verifiedPts', 'offerPts'])
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() >= 6 && request.resource.data.referrer.size() <= 128
        && request.resource.data.referrer != storeUid
        && request.resource.data.storeUid == storeUid
        && request.resource.data.storeName is string && request.resource.data.storeName.size() <= 100
        && request.resource.data.verifiedPts == 0 && request.resource.data.offerPts == 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if can('merchants');
    }

    // حالة التاجر: موثوق / موقوف — التاجر يقرأ حالته، والأدمن فقط يكتب
    match /merchantStatus/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || canStores());
      allow write: if canStores();
    }

    // ملف المطعم: صاحبه فقط يقرأ ويكتب
    match /merchants/{uid} {
      allow read, delete: if isAuthenticated() && request.auth.uid == uid;
      allow create, update: if isAuthenticated() && request.auth.uid == uid
        && (!('branches' in request.resource.data) || request.resource.data.branches.size() <= 50);
    }

    // البلاغات: أي أحد يرسل بلاغ، والأدمن فقط يقرأ ويحذف
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['offerId', 'offerTitle', 'restaurantName', 'merchantId', 'reason', 'reporterUid', 'createdAt'])
        && request.resource.data.offerId is string && request.resource.data.offerId.size() <= 100
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.offerTitle is string && request.resource.data.offerTitle.size() <= 150
        && request.resource.data.restaurantName is string && request.resource.data.restaurantName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow read, delete: if can('review');
    }

    // فريق الإدارة: المالك يضيف ويعدّل، والموظف يقرأ ملفه بس
    match /staff/{email} {
      allow read: if isAdmin() || (isAuthenticated() && myEmail() == email);
      allow write: if isAdmin();
    }

    // سجل عمليات الإدارة: يُضاف ولا يُعدّل ولا يُحذف. المالك يشوف الكل، والموظف يشوف عملياته
    match /adminLog/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.actor == myEmail());
      allow create: if (isAdmin() || isStaff())
        && request.resource.data.keys().hasOnly(['at', 'actor', 'actorUid', 'action', 'area', 'targetType', 'targetId', 'targetName', 'details', 'thumb', 'source'])
        && request.resource.data.actor == myEmail()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.area is string && request.resource.data.area.size() <= 20
        && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 1500;
      allow update, delete: if false;
    }

    // ⚡ الخصم السريع على المنيو (وثيقة وحدة لكل تاجر)
    match /quickDeals/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == uid
        && featureOn('quickDeal') && featureOn('dealDiscount')
        && !isSuspended(uid)
        && request.resource.data.keys().hasOnly(['merchantId', 'pct', 'scope', 'kind', 'section', 'itemIds', 'endsAt', 'updatedAt'])
        && request.resource.data.merchantId == uid
        && request.resource.data.pct is int && request.resource.data.pct >= 1 && request.resource.data.pct <= 90
        && request.resource.data.scope in ['all', 'kind', 'section', 'items']
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
        && request.resource.data.section is string && request.resource.data.section.size() <= 40
        && request.resource.data.itemIds is list && request.resource.data.itemIds.size() <= 50
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.time
        && request.resource.data.endsAt <= request.time + duration.value(31, 'd')
        && request.resource.data.updatedAt == request.time;
      allow delete: if (isAuthenticated() && request.auth.uid == uid) || can('merchants');
    }

    match /offers/{offerId} {
      // أي أحد يتصفح العروض المعتمدة، وصاحب العرض والأدمن يشوفون اللي بانتظار المراجعة
      allow read: if resource.data.isApproved == true
        || (isAuthenticated() && resource.data.merchantId == request.auth.uid)
        || can('review');

      // التاجر المسجّل ينشر عرض باسمه، بدون "مميز" وبعدّادات صفر
      allow create: if isAuthenticated()
        && request.resource.data.merchantId == request.auth.uid
        && request.resource.data.get('isFeatured', false) == false
        && request.resource.data.get('viewsCount', 0) == 0
        && request.resource.data.get('directionsCount', 0) == 0
        && request.resource.data.get('whatsappCount', 0) == 0
        && request.resource.data.get('reportsCount', 0) == 0
        && request.resource.data.createdAt == request.time
        && !isSuspended(request.auth.uid)
        && approvalAllowed(request.auth.uid)
        && isValidOffer(request.resource.data);

      // صاحب العرض يعدّل عرضه (بدون "مميز" والعدّادات)، والأدمن يعدّل أي شي، والزوار يزيدون العدّادات فقط
      allow update: if
        (isAuthenticated()
          && resource.data.merchantId == request.auth.uid
          && keepsProtectedFields()
          // ملاحظة الأدمن: تنمسح لما التاجر يعدّل عرضه، أو تبقى والعرض مخفي
          && (request.resource.data.get('adminNote', '') == ''
              || (request.resource.data.adminNote == resource.data.get('adminNote', '') && request.resource.data.get('isApproved', false) == false))
          // لما مكافأة الحصري شغّالة: التاجر ما يشيل الحصري بعد النشر (الأدمن بس)
          && (resource.data.get('exclusive', false) != true || request.resource.data.get('exclusive', false) == true || !exclRewardOn())
          && !isSuspended(request.auth.uid)
          && approvalAllowed(request.auth.uid)
          && isValidOffer(request.resource.data))
        || can('review')
        || isCounterIncrement();

      // صاحب العرض أو الأدمن يحذف
      allow delete: if isAuthenticated()
        && (resource.data.merchantId == request.auth.uid || can('review'));
    }
  }
}
