rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // صور وفيديوهات العروض: الكل يشوفها، والتاجر المسجّل فقط يرفع (صورة أو فيديو، أقل من 30MB)
    match /offers/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
